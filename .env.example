# Runtime environment
NODE_ENV=development
PORT=3000

# Redis (shared state: token cache, result cache, single-flight lock, rate-limiter bucket)
REDIS_URL=redis://localhost:6379

# DocketAlarm upstream
DA_BASE_URL=https://www.docketalarm.com/api/v1.1
DA_USERNAME=your_docketalarm_username_here
DA_PASSWORD=your_docketalarm_password_here
# When true, appends test=1 to every DA request so no calls are billed. Auto-true when NODE_ENV=test.
DA_TEST_MODE=false

# Cache (async-cache-dedupe over Redis)
# CACHE_STALE_SECONDS must be <= CACHE_TTL_SECONDS.
CACHE_TTL_SECONDS=1800
CACHE_STALE_SECONDS=300

# Alias fan-out — candidates below this confidence are dropped
ALIAS_CONFIDENCE_THRESHOLD=0.5

# Logging
LOG_LEVEL=info

# OpenTelemetry (optional — leave unset to disable OTel entirely)
# When set, traces are exported via OTLP-HTTP; auto-instrumentation covers undici/ioredis/pino/http.
# Example: http://localhost:4318   (the collector will handle the /v1/traces suffix)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SERVICE_NAME=legal-results-service
